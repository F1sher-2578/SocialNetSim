# ---------------- 运行时产物 ----------------
logs/
models/*.pkl
results/clip_cache.npz
results/bot_features.csv
results/reports/

# 保留实验结果 JSON 与阈值校准文件
!results/*.json
!models/calibration.json

# ---------------- 其它 ----------------
*.mp4
*.webm
*.wav
*.parquet
nohup.out
